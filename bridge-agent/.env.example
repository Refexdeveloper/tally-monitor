# ------------------------------------------------------------------
# Tally Monitor Bridge Agent configuration
# Copy to .env next to package.json. Restrict access to this file
# (scripts\install-service.ps1 does it for you).
# ------------------------------------------------------------------

# Tally Monitor API base URL (no trailing /api/v1). HTTPS is required except for localhost.
TM_API_URL=https://tally-monitor.example.com
# LAN test only (API on a developer PC, e.g. http://192.168.1.50:4000). Never in production.
# ALLOW_INSECURE_HTTP=true

# From Tally Monitor > Tally Connections > Bridge Agents > Register agent (shown once).
TM_AGENT_KEY=agt_xxxxxxxxxxxxxxxx
TM_AGENT_SECRET=
# Alternatively keep the secret in a separate protected file:
# TM_AGENT_SECRET_FILE=C:\ProgramData\TallyMonitor\agent.secret

# --- Safety switches (start with posting OFF and a test company) ----------
# When false the agent only reports health, discovers companies and syncs ledgers.
POSTING_ENABLED=false
# Let the agent create Finance-approved ledgers in Tally.
MASTER_CREATION_ENABLED=false
LEDGER_SYNC_ENABLED=true
# Exact TallyPrime company names the agent may post into / create masters in.
# Leave empty to allow every company assigned to this agent in Tally Monitor.
# Example: ALLOWED_COMPANIES=TEST COMPANY - DO NOT USE,VENWIND REFEX POWER LIMITED
ALLOWED_COMPANIES=

# --- TallyPrime connection --------------------------------------------------
# Servers (host/port) come from Tally Monitor. If the agent runs ON the Tally
# machine you can force localhost here:
# TALLY_HOST_OVERRIDE=127.0.0.1
TALLY_TIMEOUT_MS=60000
TALLY_HEALTH_TIMEOUT_MS=8000
# Cost category used when cost centre allocation is enabled for a voucher type.
COST_CATEGORY=Primary Cost Category

# --- Timing --------------------------------------------------------------------
POLL_SECONDS=10
HEARTBEAT_SECONDS=30
LEDGER_SYNC_MINUTES=30

# --- Local files ---------------------------------------------------------------
LOG_DIR=./logs
STATE_DIR=./state
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
