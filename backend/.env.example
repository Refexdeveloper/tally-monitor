# ---------------------------------------------------------------
# Tally Monitor backend configuration
# Copy to backend/.env for local development. Never commit .env.
# In GCP, inject these from Secret Manager / Cloud Run env vars.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_PUBLIC_URL=http://localhost:5173
# Public base URL of the API, used to display Kissflow webhook URLs (defaults to APP_PUBLIC_URL)
# PUBLIC_API_URL=https://tally-monitor.example.com
# Host suffixes allowed for outbound Kissflow API connection tests
KISSFLOW_ALLOWED_HOSTS=kissflow.com
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Set to the number of proxies in front of the API (Cloud Run = 1)
TRUST_PROXY=0
LOG_LEVEL=info

# --- MySQL 8 -----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tally_monitor
DB_USER=tally_monitor
DB_PASSWORD=change-me
# Cloud SQL (Cloud Run) uses a unix socket instead of host/port:
# DB_SOCKET_PATH=/cloudsql/PROJECT:REGION:INSTANCE
DB_SSL=false
DB_POOL_MAX=10

# --- Authentication ----------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_HOURS=12
REFRESH_REMEMBER_TTL_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
# Cookies are marked Secure automatically when NODE_ENV=production
COOKIE_SECURE=false

# --- Secret encryption (AES-256-GCM, 32 random bytes, base64) ----
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Integration health thresholds -------------------------------
AGENT_HEARTBEAT_TIMEOUT_SECONDS=90
# Background queue worker (auto-validation, stale lock recovery). One instance holds a DB lease at a time.
QUEUE_WORKER_ENABLED=true
QUEUE_WORKER_INTERVAL_SECONDS=10
TALLY_HEALTH_STALE_SECONDS=300

# --- Outbound email for password reset (optional) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tally Monitor <no-reply@example.com>"

# --- Seeders (development / first install only) ------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Administrator
# Optional: registers an internal Tally server record during seeding.
# It is only reachable through the Tally Bridge Agent, never from Cloud Run.
SEED_TALLY_HOST=
SEED_TALLY_PORT=9000
SEED_TALLY_RELEASE=7.1
